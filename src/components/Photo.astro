---
import { photos, srcset } from '../data/photos';

interface Props {
  id: number;
  ratio?: '43' | '45' | '169' | '11' | 'natural';
  sizes?: string;
  caption?: string;
  eager?: boolean;
  lightbox?: boolean;
  position?: string; // CSS object-position, e.g. "50% 30%"
  class?: string;
}
const { id, ratio = '43', sizes = '(max-width: 820px) 100vw, 560px', caption, eager = false, lightbox = true, position, class: cls = '' } = Astro.props;
const p = photos[id];
const classes = `ph ${ratio === 'natural' ? '' : 'ar-' + ratio} ${cls}`.trim();
---
<figure class={classes} style={`--ph:${p.color}`}>
  {lightbox ? (
    <button type="button" class="ph-btn" data-lb data-lb-id={id} aria-label={`Enlarge photo: ${p.alt}`}>
      <img src={`/img/${id}-1280.webp`} srcset={srcset(id)} sizes={sizes} alt={p.alt} width={p.w} height={p.h} loading={eager ? 'eager' : 'lazy'} decoding="async" style={position ? `object-position:${position}` : undefined} />
    </button>
  ) : (
    <img src={`/img/${id}-1280.webp`} srcset={srcset(id)} sizes={sizes} alt={p.alt} width={p.w} height={p.h} loading={eager ? 'eager' : 'lazy'} decoding="async" style={position ? `object-position:${position}` : undefined} />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
