---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, nav } from '../data/site';

interface Props { title?: string; description?: string; schema?: object[]; }
const { title, description = site.tagline, schema = [] } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Mountain cabin with natural pool, Montenegro`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;
const path = Astro.url.pathname;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  description: site.tagline,
  url: new URL('/', Astro.site).href,
  image: ogImage,
  logo: new URL('/logo-768.webp', Astro.site).href,
  priceRange: `from €${site.priceFrom} per night`,
  address: { '@type': 'PostalAddress', addressLocality: 'Opasanica', addressCountry: 'ME' },
  numberOfRooms: site.bedrooms,
  sameAs: [site.instagramUrl, site.airbnbUrl],
  amenityFeature: ['Natural swimming pool', 'Wood-burning stove', 'Outdoor kitchen with pizza oven', 'Sauna (supplement)', 'Wi-Fi', 'Free parking', 'Motorcycle washing area', 'Tools for repairs'].map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#14261d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header" id="header">
      <div class="container">
        <a class="brand" href="/" aria-label={`${site.name}, home`}>
          <img class="brand-logo" src="/logo-96.webp" srcset="/logo-96.webp 1x, /logo-192.webp 2x" width="48" height="48" alt="" />
          <span>{site.name}</span>
        </a>
        <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="nav" aria-label="Menu">
          <Icon name="menu" />
        </button>
        <nav class="nav" id="nav" aria-label="Main">
          {nav.filter((n) => n.href !== '/book/').map((n) => n.children ? (
            <div class="nav-group">
              <a href={n.href} class:list={{ active: n.children.some((c) => c.href.split('#')[0] === path) }} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
              <button type="button" class="sub-toggle" aria-expanded="false" aria-label={`Show the ${n.label} menu`}><Icon name="down" /></button>
              <div class="submenu">
                {n.children.map((c) => <a href={c.href}>{c.label}</a>)}
              </div>
            </div>
          ) : (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <a class="btn small" href="/book/">Check availability</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="grid">
          <div>
            <a class="brand" href="/">
              <img class="brand-logo big" src="/logo-192.webp" srcset="/logo-192.webp 1x, /logo-384.webp 2x" width="64" height="64" alt="" loading="lazy" />
              <span>{site.name}</span>
            </a>
            <p>A one-of-a-kind wooden cabin on a natural pool, in the village of Opasanica in the Komovi mountains of Montenegro.</p>
          </div>
          <div>
            <h4>Explore</h4>
            <ul>
              {nav.flatMap((n) => [n, ...(n.children ?? []).filter((c) => c.href !== n.href)]).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h4>Get in touch</h4>
            <ul>
              <li><a href="/contact/">Send us a message</a></li>
              {site.whatsapp && <li><a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`}>WhatsApp</a></li>}
              <li><a href={site.instagramUrl} rel="noopener" target="_blank">Instagram {site.instagramHandle}</a></li>
              <li><a href={site.airbnbUrl} rel="noopener" target="_blank">Also on Airbnb</a></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <span>© {new Date().getFullYear()} {site.name}</span>
          <span>{site.place}</span>
        </div>
      </div>
    </footer>

    <dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
      <div class="lb">
        <button class="close" type="button" aria-label="Close"><Icon name="close" /></button>
        <button class="prev" type="button" aria-label="Previous photo"><Icon name="left" /></button>
        <button class="next" type="button" aria-label="Next photo"><Icon name="right" /></button>
        <div class="lb-stage"><img id="lb-img" alt="" /></div>
        <p class="lb-cap" id="lb-cap"></p>
      </div>
    </dialog>

    <script>
      // header turns solid after the hero, mobile menu
      const header = document.getElementById('header')!;
      const toggle = document.getElementById('menu-toggle')!;
      const nav = document.getElementById('nav')!;
      const onScroll = () => header.classList.toggle('is-solid', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      toggle.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        header.classList.toggle('menu-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
      nav.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) { nav.classList.remove('open'); header.classList.remove('menu-open'); toggle.setAttribute('aria-expanded', 'false'); }
      });

      // dropdowns: hover/focus opens them on desktop, the chevron button opens them on touch
      const groups = [...document.querySelectorAll<HTMLElement>('.nav-group')];
      const closeGroups = (except?: HTMLElement) => groups.forEach((g) => {
        if (g === except) return;
        g.classList.remove('open');
        g.querySelector('.sub-toggle')?.setAttribute('aria-expanded', 'false');
      });
      groups.forEach((g) => {
        const btn = g.querySelector<HTMLButtonElement>('.sub-toggle')!;
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = !g.classList.contains('open');
          closeGroups(g);
          g.classList.toggle('open', open);
          btn.setAttribute('aria-expanded', String(open));
        });
      });
      document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.nav-group')) closeGroups(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeGroups(); });

      // reveal on scroll
      const io = new IntersectionObserver((entries) => {
        for (const en of entries) if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // lightbox
      const dlg = document.getElementById('lightbox') as HTMLDialogElement;
      const img = document.getElementById('lb-img') as HTMLImageElement;
      const cap = document.getElementById('lb-cap')!;
      let items: HTMLElement[] = [];
      let idx = 0;
      const show = (i: number) => {
        idx = (i + items.length) % items.length;
        const b = items[idx];
        const src = b.querySelector('img')!;
        img.src = `/img/${b.dataset.lbId}-1920.webp`;
        img.alt = src.alt;
        cap.textContent = src.alt;
      };
      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]');
        if (!b) return;
        const scope = b.closest('[data-lb-scope]') ?? document;
        items = [...scope.querySelectorAll<HTMLElement>('[data-lb]')].filter((el) => !el.closest('[hidden]'));
        dlg.showModal();
        show(items.indexOf(b));
      });
      dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
      dlg.querySelector('.prev')!.addEventListener('click', () => show(idx - 1));
      dlg.querySelector('.next')!.addEventListener('click', () => show(idx + 1));
      dlg.addEventListener('click', (e) => { if ((e.target as HTMLElement).classList.contains('lb') || (e.target as HTMLElement).classList.contains('lb-stage')) dlg.close(); });
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') dlg.close();
        if (e.key === 'ArrowLeft') show(idx - 1);
        if (e.key === 'ArrowRight') show(idx + 1);
      });
      let x0 = 0;
      dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      dlg.addEventListener('touchend', (e) => { const d = e.changedTouches[0].clientX - x0; if (Math.abs(d) > 60) show(idx + (d < 0 ? 1 : -1)); });
    </script>
  </body>
</html>
