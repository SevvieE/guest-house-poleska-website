---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const faq = [
  ['How many people can stay?', `The cabin comfortably sleeps up to ${site.guests} guests in two bedrooms, each with one double bed and one single bed. It suits families and small groups of friends.`],
  ['Is the cabin private?', 'Yes, the cabin is entirely yours. It sits on our family property, though, so the garden, pool and outdoor kitchen are shared spaces. We live in the main house with our young children and our friendly puppy, Raco, so you will likely see us around.'],
  ['Can I use the sauna?', `Yes. The sauna can be used for a €${site.saunaSupplement} supplement. Let us know when you book (a short message through the contact form is fine) so we can have it ready for you.`],
  ['Are motorcyclists and Trans Euro Trail riders welcome?', 'Yes. We sit directly on the Trans Euro Trail through Montenegro, with a pool, a sauna, tools for repairs and a place to wash your motorcycle. See our TET riders page for details.'],
  ['What is included in the price?', `Prices start from €${site.priceFrom} per night. The pool, outdoor kitchen and picnic area, Wi-Fi, firewood for the stove, and fresh bed linen and towels are all part of your stay. The exact price for your dates and party size is shown in the booking calendar.`],
  ['Can I visit in winter?', 'Yes, and it is beautiful. In January and February you can expect a snowy winter wonderland, and Kolašin ski resort is only 45 minutes away. The house and roads remain accessible, and the wood-burning stove keeps the whole cabin warm.'],
  ['How far are shops and the airport?', 'Kolašin, with groceries and restaurants, is about 30 minutes away. Podgorica and its airport are around an hour by car. We recommend stocking up on the way. For a proper dinner, our neighbours run a traditional family restaurant in Opasanica itself.'],
  ['How do I book?', 'Choose your dates in the booking calendar at the top of this page and book directly. If you would rather ask us something first, send us a message with the contact form. You can also find us on Airbnb.'],
];
---
<Base title="Check availability & book" description={`Check availability and book your stay at ${site.name} directly. Prices from €${site.priceFrom} per night.`}>
  <Hero photo={33} short position="50% 55%">
    <span class="eyebrow">Book your stay</span>
    <h1>Pick your dates and come stay with us.</h1>
  </Hero>

  <section class="section">
    <div class="container book-grid">
      <div class="reveal">
        <h2>Check availability and book</h2>
        <p class="lead">Pick your dates to see what is free and the exact price, then book directly with us.</p>
        <div id="booking-widget" class="widget-box"></div>
        <script
          is:inline
          src="https://cdn.hsptb.com/direct-booking-widget/widget-loader.prod.js"
          data-site-uuid={site.hospitable.siteUuid}
          data-property-id={site.hospitable.propertyId}
          data-theme={site.hospitable.theme}
          data-container="booking-widget"
        ></script>
        <noscript><p>The booking calendar needs JavaScript. You can also <a href={site.airbnbUrl}>book on Airbnb</a> or <a href="/contact/">send us a message</a>.</p></noscript>

        <p class="ask-link">Rather ask us something first? <a class="textlink" href="/contact/">Send us a message</a></p>
      </div>

      <aside class="aside reveal">
        <div class="pricebox">
          <div class="amount">€{site.priceFrom}<small>from, per night</small></div>
          <p>Choose your dates in the calendar to see the exact price for your stay.</p>
          <hr />
          <p>Sauna: €{site.saunaSupplement} supplement, booked in advance.</p>
        </div>
        <div class="altbook">
          <p><strong>Prefer another way?</strong></p>
          <p>Send us a message with the <a href="/contact/">contact form</a>{site.whatsapp && <>, chat on <a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`}>WhatsApp</a></>}, or find us on <a href={site.airbnbUrl} target="_blank" rel="noopener">Airbnb</a>.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section cream">
    <div class="container narrow faq reveal">
      <span class="eyebrow">Good to know</span>
      <h2>Questions, answered.</h2>
      {faq.map(([q, a]) => (
        <details><summary>{q}</summary><p>{a}</p></details>
      ))}
    </div>
  </section>
</Base>
