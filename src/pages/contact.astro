---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="Contact" description={`Get in touch with the hosts of ${site.name}. Questions about the cabin, the area or your stay? Send us a message and we will reply personally.`}>
  <Hero photo={36} short position="50% 60%">
    <span class="eyebrow">Contact</span>
    <h1>We would love to hear from you.</h1>
  </Hero>

  <section class="section">
    <div class="container book-grid">
      <div class="reveal">
        <h2>Send us a message</h2>
        <p class="lead">Questions about the cabin, the area or your stay? Write to us and we will reply personally.</p>
        <form class="form" id="contact" novalidate data-endpoint={site.formEndpoint}>
          <input type="hidden" name="access_key" value={site.web3formsKey} />
          <input type="hidden" name="subject" value={`New message via ${site.name} website`} />
          <input type="hidden" name="from_name" value={`${site.name} website`} />
          <div class="row">
            <div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required /></div>
            <div class="field"><label for="email">Your email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
          </div>
          <div class="field"><label for="message">Your message</label><textarea id="message" name="message" required placeholder="How can we help?"></textarea></div>

          <p class="form-note" style="margin:6px 0 14px"><strong>Planning a stay?</strong> Add your dates so we can check them for you. This is optional.</p>
          <div class="row">
            <div class="field"><label for="arrival">Arrival <span class="opt">(optional)</span></label><input id="arrival" name="arrival" type="date" /></div>
            <div class="field"><label for="departure">Departure <span class="opt">(optional)</span></label><input id="departure" name="departure" type="date" /></div>
          </div>
          <div class="row">
            <div class="field">
              <label for="guests">Guests <span class="opt">(optional)</span></label>
              <select id="guests" name="guests">
                <option value="">Not sure yet</option>
                {Array.from({ length: site.guests }, (_, i) => i + 1).map((n) => <option value={n}>{n} {n === 1 ? 'guest' : 'guests'}</option>)}
              </select>
            </div>
            <div class="field" style="justify-content:flex-end">
              <label for="sauna" style="display:flex;align-items:center;gap:12px;font-weight:500;padding:13px 0">
                <input id="sauna" name="sauna" type="checkbox" style="width:22px;height:22px;flex:none" />
                Sauna (€{site.saunaSupplement} supplement)
              </label>
            </div>
          </div>

          <input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn" type="submit">Send message <Icon name="arrow" /></button>
          <p class="form-note">We only use your details to reply to your message.</p>
          <div class="form-status" id="form-status" role="status" hidden></div>
        </form>
      </div>

      <aside class="aside reveal">
        <div class="pricebox">
          <div class="amount">Ready to book?</div>
          <p>Pick your dates in the booking calendar to see what is available and the exact price. From €{site.priceFrom} per night.</p>
          <p><a class="btn small" href="/book/">Check availability <Icon name="arrow" /></a></p>
        </div>
        <div class="altbook">
          <p><strong>Where to find us</strong></p>
          <p>{site.place}. We will send you the exact directions once your stay is confirmed.</p>
          {site.whatsapp && <p>Prefer a quick chat? <a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`}>Message us on WhatsApp</a>.</p>}
          <p>Follow along on <a href={site.instagramUrl} target="_blank" rel="noopener">Instagram</a>, or find us on <a href={site.airbnbUrl} target="_blank" rel="noopener">Airbnb</a>.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('contact') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const arrival = form.elements.namedItem('arrival') as HTMLInputElement;
  const departure = form.elements.namedItem('departure') as HTMLInputElement;

  const today = new Date().toISOString().slice(0, 10);
  arrival.min = today;
  arrival.addEventListener('change', () => {
    departure.min = arrival.value || today;
    if (departure.value && departure.value <= arrival.value) departure.value = '';
  });

  const say = (msg: string, error = false) => {
    status.hidden = false;
    status.textContent = msg;
    status.style.background = error ? '#f6dcd5' : '';
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (d.company) return; // honeypot: real visitors never fill this in
    if ((d.arrival && !d.departure) || (!d.arrival && d.departure)) { say('Please fill in both an arrival and a departure date, or leave both empty.', true); return; }
    if (d.arrival && d.departure <= d.arrival) { say('Please choose a departure date after your arrival date.', true); return; }

    const endpoint = form.dataset.endpoint;
    if (!endpoint) {
      say('Test mode: this form is not connected to an inbox yet, so nothing was sent.', true);
      return;
    }
    button.disabled = true;
    try {
      const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(d) });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      say('Thank you! Your message is on its way. We will get back to you personally.');
    } catch {
      say('Sorry, that did not go through. Please try again in a moment, or find us on Airbnb.', true);
    } finally {
      button.disabled = false;
    }
  });
</script>
